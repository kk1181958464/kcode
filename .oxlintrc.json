{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "dist-electron/**",
    "dist-cli/**",
    "release/**",
    "artifacts/**",
    "build/**",
    "mobile/**",
    "cli/kcode-cli.cjs",
    "**/*.d.ts"
  ],
  "rules": {
    "no-unused-vars": "off",
    "typescript/no-explicit-any": "warn",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "no-control-regex": "off",
    "no-useless-escape": "warn",
    "no-unused-expressions": [
      "error",
      {
        "allowTernary": true,
        "allowShortCircuit": true
      }
    ],
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "react/purity": "warn",
    "react/preserve-manual-memoization": "warn",
    "react/immutability": "warn"
  },
  "overrides": [
    {
      "files": [
        "electron/**",
        "cli/**",
        "scripts/**",
        "remote/**"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "tests/**"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        "require-yield": "off"
      }
    }
  ]
}
